# ============================================================
# Nishan Kharel Portfolio — Backend Environment Variables
# ============================================================
# Copy this file to `.env` and fill in the REAL values.
# NEVER commit .env to git.
# ============================================================

# ---------- App ----------
APP_ENV=development
DEBUG=false

# ---------- CORS ----------
# Comma-separated list of origins allowed to call this API.
# In dev, include your Live Server URL. In prod, only your real domain.
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,https://nishankharel.com.np,https://www.nishankharel.com.np

# ---------- Trusted Hosts ----------
# Host header whitelist. Block unknown hosts.
TRUSTED_HOSTS=localhost,127.0.0.1,nishankharel.com.np,www.nishankharel.com.np

# ---------- Rate limiting ----------
RATE_LIMIT_CONTACT=5/minute
RATE_LIMIT_DEFAULT=60/minute

# ---------- Database ----------
# Dev: SQLite (default, no setup required)
DATABASE_URL=sqlite:///./contact_messages.db
# Prod: PostgreSQL
# DATABASE_URL=postgresql+psycopg://portfolio_user:STRONG_PASSWORD@db:5432/portfolio_db

# ---------- SMTP (Gmail recommended) ----------
# 1. Enable 2FA on your Google account: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-char app password here (NOT your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=nkharel57@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_USE_TLS=true

MAIL_FROM=nkharel57@gmail.com
MAIL_FROM_NAME=Portfolio Contact Form
MAIL_TO=nkharel57@gmail.com

# ---------- reCAPTCHA v3 ----------
# Get keys: https://www.google.com/recaptcha/admin/create
# Add your domain, select reCAPTCHA v3
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
